# ==============================================================================
# Aigenzey Kubernetes Runtime Configuration (config.env)
# ==============================================================================
# Sourced by kubernetes-runtime/install.sh to generate ConfigMaps, Secrets,
# and Deployments. Copy this file to config.env and fill in your settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kubernetes Namespace
# ------------------------------------------------------------------------------
# Target namespace where the runtime stack will be deployed.
NAMESPACE=aigenzey-runtime

# ------------------------------------------------------------------------------
# 2. Central Control Plane Connection
# ------------------------------------------------------------------------------
# URL of the central Aigenzey Management API.
# Default SaaS: https://api.platform.aigenzey.com
AIGENZEY_API_URL=https://api.platform.aigenzey.com

# ------------------------------------------------------------------------------
# 3. Instance & Organization Identification
# ------------------------------------------------------------------------------
# Unique name identifying this Kubernetes runtime deployment / pod cluster.
INSTANCE_NAME=aigenzey-k8s-runtime

# Organization slug in Aigenzey (e.g. your tenant or client ID).
# Determines which agents and tools are mounted and synchronized.
DEFAULT_ORG=default

# Cloud region where this cluster resides (for latency reporting & logging).
POD_REGION=us-central1

# ------------------------------------------------------------------------------
# 4. Instance Administrator Credentials
# ------------------------------------------------------------------------------
# Credentials of an Instance Admin on the central Aigenzey Management API.
# Used by ARE and AI Gateway to authenticate and synchronize workflows.
INSTANCEADMIN_EMAIL=instanceadmin@aigenzey.com
INSTANCEADMIN_PASSWORD=SecretPassword123

# ------------------------------------------------------------------------------
# 5. LLM Provider API Keys
# ------------------------------------------------------------------------------
# Primary API key for Gemini / ADK agents (when using Google AI Studio).
# Obtain from Google AI Studio (https://aistudio.google.com).
GOOGLE_API_KEY=

# (Optional) Additional provider keys if your agents use OpenAI or Claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Cloud Vertex AI Settings:
# Set to 'true' to use Google Cloud Vertex AI instead of Google AI Studio API key
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# GCP Service Account JSON key for Vertex AI authentication (Application Default Credentials):
# If provided, a Kubernetes secret 'gcp-credentials' is automatically created and mounted to /etc/gcp/key.json
GCP_KEY_FILE=
# Path inside container (default: /etc/gcp/key.json when GCP_KEY_FILE or JSON_KEY is provided)
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 6. Container Registry & Pull Secret
# ------------------------------------------------------------------------------
# Name of the Kubernetes image pull secret created by setup-credentials.sh
IMAGE_PULL_SECRET_NAME=aigenzey-registry-secret

# Path to Artifact Registry credentials file (specify ONE of these, or pass via CLI flag):
# Option A: Base64 access key file (e.g. aigenzey-image-access.txt)
KEY_FILE=
# Option B: GCP Service Account JSON key file (e.g. /path/to/sa-key.json)
JSON_KEY=

# Image repositories and tags
ARE_IMAGE=us-central1-docker.pkg.dev/aigenzey-dev/aigenzey-images/are-service:latest
AI_GATEWAY_IMAGE=us-central1-docker.pkg.dev/aigenzey-dev/aigenzey-images/ai-gateway-service:latest
CRAWL4AI_IMAGE=unclecode/crawl4ai:latest
REDIS_IMAGE=redis:7-alpine

# ------------------------------------------------------------------------------
# 7. Security & Session Secrets
# ------------------------------------------------------------------------------
# Internal signing key for ARE sessions and agent deployment authentication.
# Must match the secret key used by the Aigenzey Control Plane / UI.
SECRET_KEY=AGZa########h0f7j0hfcna8do

# Bearer token for Crawl4AI web scraper service
CRAWL4AI_API_TOKEN=aigenzey-crawl4ai-internal-token

# Session Service Configuration ('redis' or 'in_memory')
SESSION_SERVICE_TYPE=redis
REDIS_URL=redis://redis-service:6379/0

# ------------------------------------------------------------------------------
# 8. Feature & Storage Flags
# ------------------------------------------------------------------------------
# Deploy AI Gateway alongside ARE (handles rate limits, KMS, and token accounting)
ENABLE_AI_GATEWAY=true

# Enable PersistentVolumeClaim for agent definitions and runtime logs
ENABLE_PVC=true
STORAGE_SIZE=10Gi
STORAGE_CLASS=

# ------------------------------------------------------------------------------
# 9. Nginx Reverse Proxy & TLS Configuration
# ------------------------------------------------------------------------------
# Enable Nginx reverse proxy on port 443 with TLS termination (default: true)
ENABLE_NGINX=true

# Hostname / domain for Nginx server_name directive
# Default: '_' (matches any hostname or IP)
# Example: NGINX_HOST=agents.mycompany.com
NGINX_HOST=_

# Custom TLS Certificate and Private Key files (PEM format)
# If provided, creates/updates the 'are-nginx-tls' secret.
# If left blank, a self-signed certificate for NGINX_HOST is automatically generated.
TLS_CERT_FILE=
TLS_KEY_FILE=
